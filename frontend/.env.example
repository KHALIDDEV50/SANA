# SANA frontend setup. Copy this file to frontend/.env to change modes.
# DEMO keeps data in browser localStorage. It does not call Spring Boot.
VITE_SANA_MODE=demo

# To connect existing Spring Boot controllers during local development:
# 1. Change VITE_SANA_MODE to api
# 2. Use the ID of a REAL test user already saved in the backend DB.
# 3. Keep API URL empty so Vite proxies /api to localhost:8080 (no CORS setup needed).
# VITE_SANA_MODE=api
# VITE_SANA_USER_ID=YOUR_EXISTING_TEST_USER_ID
# VITE_SANA_API_URL=

# The backend's current owner/userId paths are development-only until
# proper authentication and authorization are completed. Do not deploy API
# mode publicly while access-control checks are unfinished.
